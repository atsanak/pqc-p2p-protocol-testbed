# p2p/.env.example — the SINGLE source of env for the P2P peer service, same pattern as
# Device-PC/Device/.env and Gateway-PC/Gateway/.env. Deployed per-node with the real values by
# create-vms-subnets.sh (mirrors how DEVICE_NAME/GATEWAY_NAME are set per-container today).

# This node's registry name, e.g. PASH-Dev-4, PASH-Gw-0, PASH-Subgw-0.
P2P_NODE_NAME=

# The Server's API base this node already uses for provisioning (direct nodes: the Server's own
# base; routed nodes: same value Device/.env's SERVER_API_BASE or the gateway relay already uses).
SERVER_API_BASE=http://localhost:18000

# Same root-of-trust as every other box->server call (used ONLY to fetch this node's P2P cert —
# after that, peer-to-peer traffic authenticates by cert, not this secret).
BOOTSTRAP_SECRET=CHANGE_ME

# The peer service's own port — distinct from TB (18080), server API (18000), gateway proxy
# (8081), MQTT (1883/11883), per p2p-plan..md §3.2. This is the MUTUAL-auth listener: the TLS
# handshake itself refuses a certless or wrong-CA peer. Techs `mtls` and `pqc`.
P2P_PORT=8443

# The `https` tech's listener (2026-07-28) — TLS 1.3 with SERVER authentication only, for peers
# that present no client certificate; their identity is an RSA-signed envelope in the body instead.
# Strictly weaker than the port above, which is exactly why it is a SEPARATE port: nothing about
# `mtls` changes because this exists. Set it EMPTY to not run that listener at all, on a node that
# should only ever accept mutual-auth peers.
P2P_HTTPS_PORT=8444

# The `http` tech's listener (2026-09-26) — NO TLS at all, the benchmark doc's plaintext tier for
# the HTTP family (same idea `coap`'s NoSec mode already is for UDP). Identity is the SAME signed
# envelope `https` uses; unlike every other tech, the SENDER cannot verify who answered (no TLS
# session to check a peer cert against). Set it EMPTY to not run that listener at all.
P2P_HTTP_PORT=8442

# Where the fetched cert/key/CA get cached after the first /p2p-cert call.
P2P_CACHE_DIR=/var/lib/p2p/certs

# §3.8.2 phase 3, CoAP peer authentication (2026-08-21) — sender-local, per-box opt-in, NOT a
# fleet-wide flag (deliberately, unlike a bootstrap-secret rotation — see monitor.md's own
# comparison table). 0 (default) = observe mode: verify the receiver's response signature when
# present, record peer_verified, never gate. 1 = enforce: an unsigned or failed-verification CoAP
# response raises IdentityError and the exchange fails loudly. Flip this per box only once the
# monitor's S28 row (fleet-wide CoAP signing uniformity) reads 100% — flipping earlier means a
# perfectly legitimate but not-yet-updated receiver gets refused.
P2P_COAP_REQUIRE_SIGNED_RESPONSE=0

# ── device→device remote management (2026-07-28, the `rm` use case / POST /rm-exec) ────────────
# Whether this node will RUN a command another DEVICE sent it. On by default, because that is what
# was asked for ("a device X can do remote management to dev Y ... normally") — and because the
# gate that matters is the same one every other use case uses: the sender's certificate plus the
# Server's per-pair P2P policy verdict.
#
# Worth being deliberate about, though. Executing a peer's command is the strongest thing a
# receiver can do for a sender, and the IN-TENANT policy default is `allow` — so out of the box,
# every device in a tenant can run commands on every other one in that tenant. (Cross-tenant is
# `deny` by default and needs BOTH tenants' consent, so it does not have this property.) Set this
# to 0 on a node that should never accept peer-driven RM; it then refuses with a reason that says
# so, rather than failing in a way the sender would read as "your command was bad".
P2P_RM_ENABLED=1

# Optional allow-list of command PREFIXES, comma-separated. Unset (the default) = anything the
# policy admits. Set it to make a node answer only a fixed repertoire, e.g.:
#   P2P_RM_ALLOW=systemctl status,journalctl,uptime,df
#P2P_RM_ALLOW=

# ── peer-driven ML (2026-07-29, the `ml` use case / POST /ml-op) ───────────────────────────────
# Whether this node will PERFORM an ML operation another node asked it to — deliver a model, run
# it, read its parameters, report a run's state. On by default: this is what the ML GUI's "P2P on
# behalf of sender" mode drives, and it rides the same two facts as every other use case (the
# sender's certificate, the Server's per-pair policy verdict).
#
# Unlike `rm`, the verb list is ENUMERATED, not a shell — receiver-role/handlers/ml.py's
# ML_METHODS is the whole surface, and it deliberately excludes exec/put_file/cancel/set_policy
# (that is the RM surface, with its own gate). Set this to 0 on a node that should never let a peer
# touch its models; it then refuses with a reason that says so.
P2P_ML_ENABLED=1

# Optional narrowing of ML_METHODS, comma-separated. Unset (the default) = all of them. A read-only
# ML peer, for example:
#   P2P_ML_ALLOW=list_models,get_model,read_model_file,run_status
#P2P_ML_ALLOW=

# Where the receiver hands an ML call to this node's device/gateway agent. Must match the path the
# agent's container bind-mounts (Device-PC/Device/docker-compose.yml, the gateway's generated
# compose). A directory, not a port: nothing off-VM can reach it, so an ML call only ever arrives
# here after the receiver has already checked the certificate and the policy.
P2P_ML_SPOOL=/var/lib/p2p/ml-spool
