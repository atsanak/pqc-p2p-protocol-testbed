[Unit]
Description=P2P peer receiver-role server (TLS 1.3 mTLS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/p2p
EnvironmentFile=/opt/p2p/.env
ExecStart=/usr/bin/python3 /opt/p2p/receiver-role/server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
