[Unit]
Description=P2P peer receiver-role quic-pqc-mutual relay (real hybrid PQC QUIC/HTTP-3, client cert REQUIRED)
After=network-online.target p2p-receiver.service
Wants=network-online.target
Requires=p2p-receiver.service

[Service]
Type=simple
WorkingDirectory=/opt/p2p
EnvironmentFile=/opt/p2p/.env
Environment=P2P_QUIC_PQC_MUTUAL=1
ExecStart=/opt/pqc-libs/quic-pqc-venv/bin/python3 /opt/p2p/receiver-role/quic_pqc_relay.py
Restart=on-failure
RestartSec=3

[Install]
# Wanted by the receiver it Requires=, not by multi-user.target: the relay then runs exactly when
# p2p-receiver.service runs. Requires= alone carries a STOP down (a lifecycle stop/pause disables the
# receiver) but never a START back up, so with WantedBy=multi-user.target a stop + restart left
# the relay dead until the next boot (T1-Rpi51 2026-10-03). Change [Install] => `systemctl reenable`.
WantedBy=p2p-receiver.service
