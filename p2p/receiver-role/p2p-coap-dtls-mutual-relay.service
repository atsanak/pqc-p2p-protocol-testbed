[Unit]
Description=P2P peer receiver-role coap-dtls-mutual relay (DTLS 1.3, classical X25519 + RSA certs, client cert REQUIRED)
After=network-online.target p2p-receiver.service p2p-coap-receiver.service
Wants=network-online.target
Requires=p2p-coap-receiver.service

[Service]
Type=simple
WorkingDirectory=/opt/p2p
EnvironmentFile=/opt/p2p/.env
Environment=LD_LIBRARY_PATH=/opt/pqc-libs/wolfssl-dtls/lib
Environment=PYTHONPATH=/opt/PQC-bench/wolfssl-py-patch
# 2026-10-02: the SAME relay as coap-dtls-pqc, on its own port, refusing any handshake that did not
# negotiate X25519 -- so a hybrid offer cannot be answered on the classical tech's port.
Environment=P2P_COAP_DTLS_PQC_PORT=5688 P2P_COAP_DTLS_PQC_MUTUAL=1 P2P_COAP_DTLS_REQUIRE_GROUP=X25519
ExecStart=/usr/bin/python3 /opt/p2p/receiver-role/coap_dtls_pqc_relay.py
Restart=on-failure
RestartSec=3

[Install]
# Wanted by the receiver it Requires=, not by multi-user.target: the relay then runs exactly when
# p2p-coap-receiver.service runs. Requires= alone carries a STOP down (a lifecycle stop/pause disables the
# receiver) but never a START back up, so with WantedBy=multi-user.target a stop + restart left
# the relay dead until the next boot (T1-Rpi51 2026-10-03). Change [Install] => `systemctl reenable`.
WantedBy=p2p-coap-receiver.service
